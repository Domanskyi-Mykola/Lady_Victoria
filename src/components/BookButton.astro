---
import { site } from '@/data/site';

interface Props {
  /** Підпис, коли кнопка веде в Instagram. */
  instagramLabel?: string;
  /** Підпис, коли Instagram ще не підключено і кнопка дзвонить. */
  phoneLabel?: string;
  variant?: 'primary' | 'accent' | 'outline' | 'ghost';
  size?: 'md' | 'sm';
  block?: boolean;
  class?: string;
}

const {
  instagramLabel = 'Записатися',
  phoneLabel = 'Записатися',
  variant = 'accent',
  size = 'md',
  block = false,
  class: className = '',
} = Astro.props;

// Єдине джерело правди — site.instagram (src/data/site.ts).
// Поки посилання немає, кнопка «Записатися» працює як кнопка дзвінка —
// і показує відповідний до дії підпис, а не текст про Instagram.
const hasInstagram = Boolean(site.instagram);
const href = hasInstagram ? site.instagram : `tel:${site.phoneRaw}`;
const label = hasInstagram ? instagramLabel : phoneLabel;

const classes = ['btn', `btn-${variant}`, size === 'sm' ? 'btn-sm' : '', block ? 'btn-block' : '', className]
  .filter(Boolean)
  .join(' ');
---

{
  hasInstagram ? (
    <a href={href} class={classes} target="_blank" rel="noopener noreferrer nofollow">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="1.8" />
        <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.8" />
        <circle cx="17.2" cy="6.8" r="1.1" fill="currentColor" />
      </svg>
      {label}
    </a>
  ) : (
    <a href={href} class={classes}>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path
          d="M6.6 10.8c1.4 2.8 3.8 5.2 6.6 6.6l2.2-2.2c.3-.3.7-.4 1.1-.3 1.2.4 2.5.6 3.8.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.9 21 3 13.1 3 3.9c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.6.6 3.8.1.4 0 .8-.3 1.1L6.6 10.8Z"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linejoin="round"
        />
      </svg>
      {label}
    </a>
  )
}
