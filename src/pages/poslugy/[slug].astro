---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PriceTable from '@/components/PriceTable.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import BookButton from '@/components/BookButton.astro';
import PhoneBar from '@/components/PhoneBar.astro';
import { serviceCategories } from '@/data/services';
import { gallery } from '@/data/gallery';
import { site } from '@/data/site';
import { buildServiceSchema, buildBreadcrumbSchema } from '@/lib/schema';
import { withBase } from '@/lib/paths';
import { ROUTES } from '@/lib/routes';

export function getStaticPaths() {
  return serviceCategories.map((category) => ({
    params: { slug: category.slug },
    props: { category },
  }));
}

const { category } = Astro.props;

const title = category.title;
const description = `${category.description} Ціни та тривалість послуг «${category.title}» у салоні краси Lady Victoria.`;
const canonical = Astro.url.href;

const relatedCategories = serviceCategories.filter((item) => item.slug !== category.slug).slice(0, 3);
const previewImages = gallery.filter((item) => item.category === category.slug).slice(0, 3);

const serviceSchema = buildServiceSchema(category, canonical);
const breadcrumbs = buildBreadcrumbSchema([
  { name: 'Головна', url: new URL(withBase(ROUTES.home), Astro.site).toString() },
  { name: 'Послуги', url: new URL(withBase(ROUTES.services), Astro.site).toString() },
  { name: category.title, url: canonical },
]);
---

<BaseLayout title={title} description={description} structuredData={[serviceSchema, breadcrumbs]}>
  <section class="section container">
    <nav class="breadcrumbs" aria-label="Хлібні крихти">
      <a href={withBase(ROUTES.home)}>Головна</a>
      <span aria-hidden="true">/</span>
      <a href={withBase(ROUTES.services)}>Послуги</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{category.title}</span>
    </nav>

    <div class="service-hero">
      <div>
        <span class="eyebrow">Послуга</span>
        <h1>{category.title}</h1>
        <p class="lead">{category.description}</p>
        <div class="service-hero__actions">
          <BookButton />
          <PhoneBar variant="block" />
        </div>
      </div>
      <img
        src={withBase(`/images/services/${category.slug}.svg`)}
        alt=""
        width="560"
        height="400"
        class="service-hero__image"
      />
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="section-head">
        <h2>Прайс</h2>
        <p class="lead">{category.priceNote}</p>
      </div>
      <PriceTable items={category.items} />
    </div>
  </section>

  {
    previewImages.length > 0 && (
      <section class="section container">
        <div class="section-head">
          <h2>Приклади робіт</h2>
        </div>
        <div class="grid grid-3">
          {previewImages.map((item) => (
            <img src={withBase(item.image)} alt={item.alt} loading="lazy" width="480" height="320" class="preview-image" />
          ))}
        </div>
        <p>
          <a href={withBase(ROUTES.gallery)}>Дивитись усі роботи в галереї →</a>
        </p>
      </section>
    )
  }

  <section class="section section--alt">
    <div class="container">
      <div class="section-head">
        <h2>Інші послуги</h2>
      </div>
      <div class="grid grid-3">
        {relatedCategories.map((related) => <ServiceCard category={related} />)}
      </div>
    </div>
  </section>

  <section class="section container">
    <div class="cta-block" data-reveal>
      <h2>Готові записатися на «{category.title}»?</h2>
      <p class="lead">
        {
          site.instagram
            ? 'Напишіть нам в Instagram або зателефонуйте — підберемо зручний час.'
            : 'Зателефонуйте нам — підберемо зручний час.'
        }
      </p>
      <div class="cta-block__actions">
        <BookButton />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    font-size: var(--fs-small);
    color: var(--color-text-soft);
    margin-bottom: var(--space-6);
  }

  .breadcrumbs a {
    color: var(--color-text-soft);
    text-decoration: none;
  }

  .breadcrumbs a:hover {
    color: var(--color-primary);
  }

  .breadcrumbs [aria-current='page'] {
    color: var(--color-primary-strong);
    font-weight: 600;
  }

  .service-hero {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: var(--space-7);
    align-items: center;
  }

  .service-hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-5);
    margin-top: var(--space-5);
  }

  .service-hero__image {
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
  }

  .preview-image {
    width: 100%;
    height: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }

  .cta-block {
    text-align: center;
    background: var(--color-primary);
    color: var(--color-on-primary);
    border-radius: var(--radius-lg);
    padding: var(--space-8) var(--space-5);
  }

  .cta-block h2 {
    color: var(--color-on-primary);
  }

  .cta-block .lead {
    color: var(--color-gold-100);
    margin-bottom: var(--space-5);
  }

  .cta-block__actions {
    display: flex;
    justify-content: center;
  }

  @media (max-width: 860px) {
    .service-hero {
      grid-template-columns: 1fr;
    }

    .service-hero__image {
      order: -1;
    }
  }
</style>
